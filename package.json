{
  "name": "agile-form",
  "version": "0.0.472",
  "description": "Reusable form builder with support for (richt-)text, code, selections, numbers, dates and so on.",
  "keywords": [
    "component",
    "form",
    "react",
    "web",
    "webcomponent",
    "web-component"
  ],
  "homepage": "https://torben.website/agile-form",
  "bugs": {
    "email": "info@torben.website",
    "url": "https://github.com/thaibault/agile-form/issues"
  },
  "license": "CC-BY-3.0",
  "author": {
    "email": "info@torben.website",
    "name": "Torben Sickert",
    "url": "https://torben.website"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thaibault/agile-form"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "yarn build:types; yarn build:plain && yarn build:bundle:plain",
    "build:bundle:plain": "weboptimizer build '{__reference__: \"target:bundle\"}'",
    "build:plain": "weboptimizer build",
    "build:types": "weboptimizer build:types",
    "check": "yarn check:types; yarn lint",
    "check:types": "yarn clear && weboptimizer check:types",
    "clear": "weboptimizer clear && rimraf styles.bundle.css",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "serve": "weboptimizer serve",
    "serve:simple": "yarn serve '{files: {defaultHTML: {filename: \"examples/simple.html\"}}}'",
    "start": "yarn serve",
    "test": "yarn clear && weboptimizer test",
    "test:browser": "yarn clear && weboptimizer test:browser",
    "test:coverage": "yarn clear && weboptimizer test:coverage",
    "test:coverage:report": "yarn clear && weboptimizer test:coverage:report",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@eslint/js": "^10.0.1",
    "@rmwc/card": "^14.3.5",
    "@rmwc/checkbox": "^14.3.5",
    "@rmwc/circular-progress": "^14.3.5",
    "@rmwc/formfield": "^14.3.5",
    "@rmwc/icon": "^14.3.5",
    "@rmwc/icon-button": "^14.3.5",
    "@rmwc/select": "^14.3.5",
    "@rmwc/slider": "patch:@rmwc/slider@npm%3A14.3.5#~/.yarn/patches/@rmwc-slider-npm-14.3.5-c8fe4ac3a5.patch",
    "@rmwc/tabs": "^14.3.5",
    "@rmwc/textfield": "^14.3.5",
    "@rmwc/theme": "^14.3.5",
    "@rmwc/tooltip": "^14.3.5",
    "@rmwc/touch-target": "^14.3.5",
    "@rmwc/typography": "^14.3.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extensions": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@types/ejs": "^3.1.5",
    "@types/grecaptcha": "^3.0.9",
    "@types/html-minifier": "^4.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-transition-group": "^4.4.12",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "blob-util": "^2.0.2",
    "clientnode": "^4.0.1501",
    "css-loader": "^7.1.4",
    "cssnano": "^8.0.10",
    "eslint": "^10.9.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^64.2.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-canvas-mock": "^2.5.8",
    "jsdoc": "^4.0.5",
    "material-components-web": "^14.0.0",
    "material-icons": "^1.13.14",
    "mini-css-extract-plugin": "^2.10.2",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.5.0",
    "postcss-scss": "^4.0.9",
    "prop-types": "^15.8.1",
    "react-generic-animate": "^0.0.130",
    "react-generic-dummy": "^0.0.134",
    "react-generic-tools": "^0.0.124",
    "react-useanimations": "^2.10.0",
    "rimraf": "^6.1.3",
    "spark-md5": "^3.0.2",
    "style-loader": "^4.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tslib": "^2.8.1",
    "typescript-eslint": "^8.68.0",
    "web-component-wrapper": "^0.0.611",
    "web-documentation": "^1.0.51",
    "web-input-material": "^0.0.514",
    "weboptimizer": "^4.0.69",
    "webpack-dev-server": "^6.0.0"
  },
  "peerDependencies": {
    "clientnode": "*",
    "node-fetch": "*"
  },
  "peerDependenciesMeta": {
    "node-fetch": {
      "optional": true
    }
  },
  "resolutions": {
    "@rmwc/ripple@npm:14.0.11": "patch:@rmwc/ripple@npm%3A14.0.11#~/.yarn/patches/@rmwc-ripple-npm-14.0.11-22d1530040.patch",
    "@rmwc/ripple@npm:14.3.4": "patch:@rmwc/ripple@npm%3A14.3.4#~/.yarn/patches/@rmwc-ripple-npm-14.3.4-27648eff11.patch",
    "@rmwc/ripple@npm:14.3.5": "patch:@rmwc/ripple@npm%3A14.3.5#~/.yarn/patches/@rmwc-ripple-npm-14.3.5-9657693602.patch",
    "colors": "1.4.0",
    "globals@npm:^11.1.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^14.0.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^9.18.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "tagline": "Build flexible agnostic forms.",
    "trackingCode": "TODO"
  },
  "webOptimizer": {
    "commandLine": {
      "test": {
        "environments": [
          "jsdom"
        ]
      }
    },
    "development": {
      "server": {
        "port": 8082
      }
    },
    "generic": {
      "supportedBrowsers": [
        "IE >= 11",
        "last 2 versions",
        "> 5%"
      ]
    },
    "injection": {
      "entry": {
        "__evaluate__": "2 < self.givenCommandLineArguments.length && self.givenCommandLineArguments[2] === 'serve' ? {index: './index', styles: './index.css', webInputMaterial: 'web-input-material'} : 2 < self.givenCommandLineArguments.length && self.givenCommandLineArguments[2].startsWith('test') ? {testBundle: './test.ts'} : {index: './index', styles: './index.css'}"
      }
    },
    "module": {
      "aliases": {
        "#": "Remove unneeded optional dependencies.",
        "@codemirror/autocomplete": "react-input-material/shims/optionals",
        "@codemirror/commands": "react-input-material/shims/optionals",
        "@codemirror/lang-css": "react-input-material/shims/optionals",
        "@codemirror/lang-javascript": "react-input-material/shims/optionals",
        "@codemirror/language": "react-input-material/shims/optionals",
        "@codemirror/lint": "react-input-material/shims/optionals",
        "@codemirror/search": "react-input-material/shims/optionals",
        "@codemirror/state": "react-input-material/shims/optionals",
        "@codemirror/view": "react-input-material/shims/optionals",
        "@rmwc/tooltip": "react-input-material/shims/optionals",
        "@tiptap/core$": "react-input-material/shims/optionals",
        "@tiptap/extensions$": "react-input-material/shims/optionals",
        "@tiptap/react$": "react-input-material/shims/optionals",
        "@tiptap/starter-kit$": "react-generic-dummy",
        "formdata-polyfill/esm.min.js$": "formdata-polyfill",
        "react-useanimations$": "react-generic-dummy",
        "react-useanimations/lib/lock$": "react-generic-dummy",
        "react-useanimations/lib/plusToX$": "react-generic-dummy"
      },
      "enforceDeduplication": true,
      "html": {
        "options": {
          "sources": {
            "urlFilter": {
              "#": "Do not process any referenced resource in HTML.",
              "__evaluate__": "() => false"
            }
          }
        }
      },
      "optimizer": {
        "terser": {
          "terserOptions": {
            "compress": {
              "#": "To provide a logging output we need to exclude this feature.",
              "drop_console": {
                "__evaluate__": "false"
              },
              "drop_debugger": {
                "__evaluate__": "false"
              }
            }
          }
        }
      }
    },
    "path": {
      "source": {
        "base": "src/"
      },
      "target": {
        "base": "dist/"
      }
    },
    "target:bundle": {
      "inPlace": {
        "externalLibrary": {
          "dynamic": true,
          "normal": true
        }
      },
      "path": {
        "target": {
          "base": "dist/bundle/"
        }
      }
    },
    "test": {
      "injection": {
        "external": {
          "implicit": {
            "pattern": {
              "exclude": {
                "#": "NOTE: Theses files are ECMAscript file so have to be processed to work with test-runner.",
                "__append__": [
                  {
                    "__evaluate__": "/^(.+\\/)?data-uri-to-buffer(\\/.+)?$/"
                  },
                  {
                    "__evaluate__": "/^(.+\\/)?fetch-blob(\\/.+)?$/"
                  },
                  {
                    "__evaluate__": "/^(.+\\/)?node-fetch(\\/.+)?$/"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "webpack": {
      "snapshot": {
        "unmanagedPaths": [
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]clientnode[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]react-generic-(animate|dummy|tools)[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/](react|web)-input-material[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]web-component-wrapper[\\/]/"
          }
        ]
      },
      "watchOptions": {
        "ignored": {
          "__remove__": "**/node_modules"
        }
      }
    }
  },
  "packageManager": "yarn@4.18.0"
}